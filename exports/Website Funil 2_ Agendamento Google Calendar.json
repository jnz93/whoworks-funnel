    {
      "parameters": {
        "jsCode": "// O objeto completo vem em $json, com a estrutura fornecida\nconst body = $json.body; // ou diretamente $json se o body já estiver no nível raiz\n\n// Pega o slot_id escolhido\nconst selectedSlotId = body.slot_id;\n\n// Localiza o slot correspondente no array slots_originais\nconst selectedSlot = body.slots_originais.find(slot => slot.id === selectedSlotId);\n\n// Verifica se encontrou\nif (!selectedSlot) {\n  throw new Error(`Slot com ID \"${selectedSlotId}\" não encontrado em slots_originais.`);\n}\n\n// Extrai os campos no formato desejado (start_time e end_time)\nconst start_time = selectedSlot.starts_at;\nconst end_time = selectedSlot.ends_at;\n\n// Retorna os dados para os próximos nós\nreturn {\n  start_time,\n  end_time,\n  // Opcional: retorna também os dados completos para referência\n  selected_slot: selectedSlot,\n  slot_label: selectedSlot.label,\n};"
      },
